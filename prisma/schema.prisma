datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  phone           String           @unique
  email           String?
  passwordHash    String
  role            String           @default("FARMER") // Legacy primary role
  roles           String           @default("FARMER,LABOURER,MACHINE_OWNER") // Enabled multi-roles
  activeRole      String           @default("FARMER") // Currently active role: FARMER, LABOURER, MACHINE_OWNER
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  farmerProfile   FarmerProfile?
  labourerProfile LabourerProfile?
  machineProfile  MachineProfile?
}

model FarmerProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  farmName     String?
  district     String
  taluka       String?
  village      String?
  primaryCrops String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  jobPosts     JobPost[]
}

model LabourerProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  skills          String           // "Harvesting, Weeding, Spraying"
  experienceYears Int              @default(0)
  isCrewLeader    Boolean          @default(false)
  crewSize        Int              @default(1)
  district        String
  taluka          String?
  village         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  applications    JobApplication[]
}

model MachineProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  machineTypes    String           @default("Tractor, Rotavator")
  experienceYears Int              @default(2)
  district        String
  taluka          String?
  village         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  listings        MachineListing[]
}

model MachineListing {
  id          String         @id @default(cuid())
  ownerId     String
  owner       MachineProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  machineType String         // TRACTOR, HARVESTER, SPRAYER, ROTAVATOR, THRESHER
  hourlyRate  Int
  acreRate    Int?
  district    String
  taluka      String?
  village     String?
  description String?
  isAvailable Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([district, machineType, isAvailable])
  @@index([ownerId])
}

model JobPost {
  id              String           @id @default(cuid())
  farmerId        String
  farmer          FarmerProfile    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  title           String
  cropType        String
  activity        String           // SOWING, WEEDING, SPRAYING, HARVESTING, PACKAGING, GENERAL
  workersNeeded   Int
  dailyWage       Int
  wageType        String           @default("PER_DAY") // PER_DAY, PER_ACRE, PER_BAG
  startDate       DateTime
  endDate         DateTime
  state           String           @default("Maharashtra")
  district        String
  taluka          String?
  village         String?
  additionalPerks String?
  status          String           @default("OPEN") // OPEN, FILLED, COMPLETED, CANCELLED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  applications    JobApplication[]

  @@index([status, district, activity])
  @@index([farmerId])
}

model JobApplication {
  id             String          @id @default(cuid())
  jobPostId      String
  jobPost        JobPost         @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  labourerId     String
  labourer       LabourerProfile @relation(fields: [labourerId], references: [id], onDelete: Cascade)
  workersOffered Int             @default(1)
  applicantNote  String?
  status         String          @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([jobPostId, labourerId])
  @@index([jobPostId])
  @@index([labourerId])
}
