# ==========================================
# Agromate Environment Configuration Example
# ==========================================

# Database Connection (PostgreSQL or local dev SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agromate?schema=public"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="agromate-super-secret-jwt-key-minimum-32-chars-replace-in-production"

# Runtime Environment
NODE_ENV="development"
PORT=3000
